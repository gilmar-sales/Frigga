{
  "name": "frigga",
  "displayName": "Frigga",
  "description": "Scaffold gameplay components/systems and attach GDB to the Frigga Editor",
  "version": "0.2.0",
  "publisher": "frigga",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "activationEvents": [
    "workspaceContains:**/frigga.project"
  ],
  "extensionDependencies": [
    "ms-vscode.cpptools"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "frigga.newComponent",
        "title": "Frigga: New Gameplay Component"
      },
      {
        "command": "frigga.newSystem",
        "title": "Frigga: New Gameplay System"
      },
      {
        "command": "frigga.attachDebugger",
        "title": "Frigga: Attach Debugger to Editor"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "frigga.newComponent",
          "when": "frigga.projectOpen",
          "group": "frigga@1"
        },
        {
          "command": "frigga.newSystem",
          "when": "frigga.projectOpen",
          "group": "frigga@2"
        },
        {
          "command": "frigga.attachDebugger",
          "when": "frigga.projectOpen",
          "group": "frigga@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  }
}
